# Optional. Copy to .env.local; never commit your local configuration.
# Start: node --env-file=.env.local server.mjs
# No DSN means no Sentry SDK initialization and no outgoing traces.
SENTRY_DSN=
# Run evidence -> local inference -> citation validation through Mastra.
TOD_MASTRA=1
# Optional Temporal CLI/worker, not required for the normal web app.
TEMPORAL_ADDRESS=127.0.0.1:7233
